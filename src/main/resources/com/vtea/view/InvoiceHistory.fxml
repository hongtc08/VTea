<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import java.net.URL?>
<VBox spacing="20" styleClass="screen-root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vtea.controller.InvoiceHistoryController">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <Label text="Lịch sử hóa đơn" styleClass="screen-title"/>

    <TextField fx:id="searchField" promptText="🔍 Tìm kiếm theo mã HĐ, nhân viên, khách hàng..." styleClass="input-field"/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox fx:id="invoiceGroupsContainer" spacing="16">
        </VBox>
    </ScrollPane>
</VBox>