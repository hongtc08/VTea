<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox spacing="12" alignment="CENTER_LEFT" styleClass="recipe-row"
      stylesheets="@../css/styles.css"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <StackPane styleClass="recipe-row-index">
        <Label text="1"/>
    </StackPane>

    <VBox spacing="3" HBox.hgrow="ALWAYS" maxWidth="Infinity">
        <Label text="Trà đen" styleClass="recipe-ingredient-name"/>
        <Label text="Nguyên liệu chính" styleClass="recipe-ingredient-note"/>
    </VBox>

    <HBox alignment="CENTER" spacing="0" styleClass="recipe-stepper" prefWidth="132">
        <Button styleClass="recipe-stepper-btn">
            <graphic>
                <FontIcon iconLiteral="fth-minus" iconSize="16" iconColor="#4b5563"/>
            </graphic>
        </Button>
        <TextField text="1.00" alignment="CENTER" styleClass="recipe-stepper-value"/>
        <Button styleClass="recipe-stepper-btn">
            <graphic>
                <FontIcon iconLiteral="fth-plus" iconSize="16" iconColor="#4b5563"/>
            </graphic>
        </Button>
    </HBox>

    <StackPane styleClass="recipe-unit-pill">
        <Label text="đơn vị"/>
    </StackPane>

    <Button styleClass="recipe-remove-icon-btn">
        <graphic>
            <FontIcon iconLiteral="fth-trash-2" iconSize="16" iconColor="#dc2626"/>
        </graphic>
    </Button>
</HBox>
