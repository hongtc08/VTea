<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox prefWidth="680"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vtea.controller.RecipeFormController">
    <styleClass>
        <String fx:value="modal-container"/>
        <String fx:value="recipe-form"/>
    </styleClass>

    <stylesheets>
        <URL value="@../css/styles.css"/>
    </stylesheets>

    <StackPane styleClass="recipe-hero">
        <HBox alignment="CENTER_LEFT" spacing="16">
            <StackPane styleClass="recipe-hero-icon">
                <FontIcon iconLiteral="fth-clipboard" iconSize="28" iconColor="#ffffff"/>
            </StackPane>
            <VBox spacing="6">
                <Label text="Thêm công thức" styleClass="recipe-hero-title"/>
                <Label text="Thiết lập nguyên liệu và định lượng cho từng món" styleClass="recipe-hero-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnClose" styleClass="recipe-hero-close-btn">
                <graphic>
                    <FontIcon iconLiteral="fth-x" iconSize="20" iconColor="#ffffff"/>
                </graphic>
            </Button>
        </HBox>
    </StackPane>

    <VBox spacing="18" styleClass="recipe-body">
        <VBox spacing="14" styleClass="recipe-add-card">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label text="Thêm nguyên liệu" styleClass="recipe-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <VBox spacing="6" HBox.hgrow="ALWAYS">
                    <Label text="Nguyên liệu" styleClass="recipe-field-label"/>
                    <ComboBox promptText="Chọn nguyên liệu..." maxWidth="Infinity"
                              styleClass="recipe-field"/>
                </VBox>
                <VBox spacing="6">
                    <Label text="Định lượng" styleClass="recipe-field-label"/>
                    <HBox alignment="CENTER" spacing="0" styleClass="recipe-stepper" prefWidth="132">
                        <Button styleClass="recipe-stepper-btn">
                            <graphic>
                                <FontIcon iconLiteral="fth-minus" iconSize="16" iconColor="#4b5563"/>
                            </graphic>
                        </Button>
                        <TextField text="1.00" alignment="CENTER" styleClass="recipe-stepper-value"/>
                        <Button styleClass="recipe-stepper-btn">
                            <graphic>
                                <FontIcon iconLiteral="fth-plus" iconSize="16" iconColor="#4b5563"/>
                            </graphic>
                        </Button>
                    </HBox>
                </VBox>
                <VBox spacing="6">
                    <Label text="Đơn vị" styleClass="recipe-field-label"/>
                    <StackPane styleClass="recipe-unit-pill">
                        <Label text="đơn vị"/>
                    </StackPane>
                </VBox>
                <VBox spacing="6">
                    <Label text=" " styleClass="recipe-field-label"/>
                    <Button text="Thêm" styleClass="recipe-add-btn" prefWidth="104"/>
                </VBox>
            </HBox>
        </VBox>

        <VBox spacing="12" styleClass="recipe-list-card">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="3">
                    <Label text="Danh sách nguyên liệu" styleClass="recipe-section-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="1 nguyên liệu" styleClass="recipe-count-badge"/>
            </HBox>

            <HBox styleClass="recipe-table-header" alignment="CENTER_LEFT" spacing="12">
                <Label text="Nguyên liệu" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <Label text="Định lượng" prefWidth="132"/>
                <Label text="Đơn vị" prefWidth="72"/>
                <Region prefWidth="56"/>
            </HBox>

            <VBox fx:id="ingredientsContainer" spacing="10">
                <!-- Các RecipeIngredientItem sẽ được code Java thêm vào đây (dynamic) -->
            </VBox>
        </VBox>

        <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="recipe-footer">
            <Button fx:id="btnCancel" text="Hủy bỏ" styleClass="recipe-cancel-btn" prefWidth="132"/>
            <Button fx:id="btnSubmit" text="Lưu công thức" styleClass="recipe-submit-btn" prefWidth="160"/>
        </HBox>
    </VBox>
</VBox>
