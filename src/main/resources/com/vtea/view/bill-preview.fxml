<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.text.TextFlow?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.vtea.controller.BillPreviewController"
      spacing="14"
      prefWidth="470"
      prefHeight="680"
      style="-fx-background-color: #eeeeee;">

    <padding>
        <Insets top="18" right="18" bottom="18" left="18"/>
    </padding>

    <ScrollPane prefWidth="430" prefHeight="585" fitToWidth="true" style="-fx-background: white; -fx-background-color: white; -fx-border-color: #d0d0d0; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 20;">
        <VBox alignment="TOP_CENTER" style="-fx-background-color: white;">
            <TextFlow fx:id="billTextFlow" textAlignment="LEFT" maxWidth="-Infinity" style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 14px; -fx-background-color: white;"/>
        </VBox>
    </ScrollPane>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Xuất PDF"
                onAction="#handleExportPdf"
                style="
                    -fx-background-color: #222222;
                    -fx-text-fill: white;
                    -fx-font-weight: bold;
                    -fx-padding: 8 18;
                    -fx-background-radius: 4;
                "/>

        <Button text="Đóng"
                onAction="#handleClose"
                style="
                    -fx-background-color: #dddddd;
                    -fx-text-fill: #222222;
                    -fx-padding: 8 18;
                    -fx-background-radius: 4;
                "/>
    </HBox>
</VBox>