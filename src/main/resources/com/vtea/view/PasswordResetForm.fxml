<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<VBox spacing="20" styleClass="dialog-box" prefWidth="400" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vtea.controller.PasswordResetController">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT">
        <Label text="Đổi mật khẩu" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnClose" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-cursor: hand;">
            <graphic><FontIcon iconLiteral="fth-x" iconSize="24" iconColor="#999999"/></graphic>
        </Button>
    </HBox>
    <Separator/>

    <VBox spacing="16">
        <VBox spacing="6">
            <Label text="Mật khẩu hiện tại *" styleClass="form-label"/>
            <PasswordField fx:id="txtOldPassword" promptText="Nhập mật khẩu cũ..." styleClass="form-input-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Mật khẩu mới *" styleClass="form-label"/>
            <PasswordField fx:id="txtNewPassword" promptText="Nhập mật khẩu mới (tối thiểu 6 ký tự)..." styleClass="form-input-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Xác nhận mật khẩu *" styleClass="form-label"/>
            <PasswordField fx:id="txtConfirmPassword" promptText="Nhập lại mật khẩu mới..." styleClass="form-input-field"/>
        </VBox>
    </VBox>

    <HBox spacing="16" alignment="CENTER_RIGHT">
        <VBox.margin><Insets top="10"/></VBox.margin>
        <Button text="Hủy" onAction="#handleCancel" styleClass="btn-dialog-cancel" prefWidth="100" prefHeight="40"/>
        <Button text="Cập nhật" onAction="#handleSave" styleClass="btn-primary" prefWidth="120" prefHeight="40"/>
    </HBox>
</VBox>