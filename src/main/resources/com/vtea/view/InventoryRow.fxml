<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="list-item-row" alignment="CENTER_LEFT" spacing="16">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT" spacing="12" prefWidth="250">
        <StackPane styleClass="inventory-icon-box">
            <FontIcon iconLiteral="fth-package" iconSize="20" iconColor="#523628"/>
        </StackPane>
        <Label fx:id="lblName" text="Trân châu" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
    </HBox>

    <Label fx:id="lblCategory" text="Topping" style="-fx-text-fill: #666666;" prefWidth="120"/>

    <Label fx:id="lblQuantity" text="50 kg" style="-fx-font-weight: bold;" prefWidth="100"/>

    <Label fx:id="lblMinStock" text="10 kg" style="-fx-text-fill: #666666;" prefWidth="140"/>

    <HBox prefWidth="120" alignment="CENTER_LEFT">
        <StackPane fx:id="badgeStatus" styleClass="badge-success">
            <HBox alignment="CENTER" spacing="4">
                <FontIcon fx:id="iconWarning" iconLiteral="fth-alert-triangle" iconSize="14" iconColor="#D93025" visible="false" managed="false"/>
                <Label fx:id="lblStatus" text="Đủ hàng"/>
            </HBox>
        </StackPane>
    </HBox>

    <Label fx:id="lblLastUpdate" text="2026-05-10" style="-fx-text-fill: #666666;" prefWidth="140"/>

    <HBox prefWidth="80" alignment="CENTER" spacing="0">
        <Button fx:id="btnEdit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 8;">
            <graphic>
                <FontIcon iconLiteral="fth-edit-2" iconSize="18" iconColor="#1890ff"/>
            </graphic>
        </Button>
        <Button fx:id="btnDelete" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 8;">
            <graphic>
                <FontIcon iconLiteral="fth-trash-2" iconSize="18" iconColor="#D93025"/>
            </graphic>
        </Button>
    </HBox>
</HBox>