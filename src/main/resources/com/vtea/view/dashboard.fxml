<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>


<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vtea.controller.DashboardController"
      spacing="24" styleClass="screen-root">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>


    <!-- ===== Header ===== -->
    <VBox spacing="4">
        <Label text="Dashboard" styleClass="screen-title"/>
        <Label text="Tổng quan hoạt động kinh doanh" styleClass="screen-subtitle"/>
    </VBox>

    <!-- ===== Stats Grid (4 cards) ===== -->
    <GridPane hgap="16" vgap="16">
        <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
        </columnConstraints>

        <!-- Doanh thu -->
        <VBox GridPane.columnIndex="0" styleClass="stat-card-1" spacing="8">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-box">
                    <FontIcon iconLiteral="fth-dollar-sign" iconSize="26"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Doanh thu tháng này" styleClass="stat-label"/>
            <Label fx:id="revenueTodayLabel" text="—" styleClass="stat-value"/>
        </VBox>

        <!-- Đơn hàng -->
        <VBox GridPane.columnIndex="1" styleClass="stat-card-2" spacing="8">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-box">
                    <FontIcon iconLiteral="fth-shopping-bag" iconSize="26"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Đơn hàng (tháng)" styleClass="stat-label"/>
            <Label fx:id="ordersTodayLabel" text="—" styleClass="stat-value"/>
        </VBox>

        <!-- Khách hàng -->
        <VBox GridPane.columnIndex="2" styleClass="stat-card-3" spacing="8">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER_LEFT">
                <StackPane styleClass="stat-icon-box">
                    <FontIcon iconLiteral="fth-users" iconSize="26"/>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label text="Khách hàng (tháng)" styleClass="stat-label"/>
            <Label fx:id="customersTodayLabel" text="—" styleClass="stat-value"/>
        </VBox>

    </GridPane>

    <!-- ===== Bottom 2 Panels ===== -->
    <HBox spacing="16" VBox.vgrow="ALWAYS">

        <!-- Recent Orders (Đơn hàng gần đây) -->
        <VBox styleClass="card" HBox.hgrow="ALWAYS" spacing="12">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fth-clock" iconSize="18" iconColor="#4b5563"/>
                <Label text="Đơn hàng gần đây" styleClass="card-title" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
            <VBox fx:id="vboxRecentOrders" spacing="8" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Top Products (Sản phẩm bán chạy) -->
        <VBox styleClass="card" prefWidth="320" spacing="12">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fth-star" iconSize="18" iconColor="#eab308"/>
                <Label text="Sản phẩm bán chạy" styleClass="card-title" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
            <VBox fx:id="vboxTopProducts" spacing="8" VBox.vgrow="ALWAYS"/>
        </VBox>

        <!-- Cảnh báo hết hàng -->
        <VBox styleClass="card" prefWidth="300" spacing="12">
            <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="8">
                <FontIcon iconLiteral="fth-alert-triangle" iconSize="18" iconColor="#D93025"/>
                <Label text="Cảnh báo tồn kho" styleClass="card-title" style="-fx-text-fill: #D93025; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            </HBox>
            <VBox fx:id="vboxLowStock" spacing="8" VBox.vgrow="ALWAYS"/>
        </VBox>

    </HBox>
</VBox>
