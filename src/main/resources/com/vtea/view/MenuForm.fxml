<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<?import javafx.scene.image.ImageView?>
<VBox spacing="20" styleClass="modal-container" prefWidth="520"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vtea.controller.MenuFormController">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <padding>
        <Insets top="28" right="28" bottom="28" left="28"/>
    </padding>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblFormTitle" text="Thêm món mới"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #523628;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnClose" style="-fx-background-color: transparent; -fx-cursor: hand;">
            <graphic>
                <FontIcon iconLiteral="fth-x" iconSize="20" iconColor="#999999"/>
            </graphic>
        </Button>
    </HBox>

    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" hbarPolicy="NEVER">
        <VBox spacing="18">
            <VBox spacing="8">
                <Label fx:id="lblNameField" text="Tên món ăn" styleClass="form-label"/>
                <TextField fx:id="txtName" promptText="Ví dụ: Trà sữa trân châu hoàng kim" styleClass="form-input-field"/>
            </VBox>

            <HBox fx:id="categoryPriceRow" spacing="16">
                <VBox fx:id="categoryFieldBox" spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Loại món" styleClass="form-label"/>
                    <ComboBox fx:id="cbCategory" maxWidth="Infinity" promptText="Chọn loại..." styleClass="form-input-field"/>
                </VBox>
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Giá bán (VNĐ)" styleClass="form-label"/>
                    <TextField fx:id="txtPrice" promptText="50.000" styleClass="form-input-field"/>
                </VBox>
            </HBox>

            <VBox fx:id="imageSection" spacing="8">
                <Label fx:id="lblImageField" text="Hình ảnh món ăn" styleClass="form-label"/>
                <VBox fx:id="imageUploadArea" alignment="CENTER" spacing="12" prefHeight="150" styleClass="image-upload-placeholder">
                    <FontIcon iconLiteral="fth-image" iconSize="32" iconColor="#BBBBBB"/>
                    <VBox alignment="CENTER" spacing="2">
                        <Label text="Nhấn để tải ảnh lên" style="-fx-text-fill: #523628; -fx-font-weight: bold;"/>
                        <Label text="Hỗ trợ: JPG, PNG (Tối đa 2MB)" style="-fx-text-fill: #999999; -fx-font-size: 11px;"/>
                    </VBox>
                    <ImageView fx:id="imgPreview" fitWidth="100" fitHeight="100" preserveRatio="true" managed="false" visible="false"/>
                </VBox>
            </VBox>

            <VBox spacing="10">
                <HBox alignment="CENTER_LEFT">
                    <VBox spacing="2">
                        <Label text="Công thức" styleClass="form-label"/>
                        <Label text="Nguyên liệu dùng để tạo món này" style="-fx-text-fill: #999999; -fx-font-size: 11px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnEditRecipe" text="Thêm công thức" styleClass="action-btn-primary"/>
                </HBox>
                <VBox spacing="6"
                      style="-fx-background-color: #FAF9F8; -fx-background-radius: 10; -fx-padding: 12;">
                    <Label text="Chưa có nguyên liệu trong công thức."
                           style="-fx-text-fill: #999999; -fx-font-size: 12px;"/>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button fx:id="btnCancel" text="Hủy bỏ"
                style="-fx-background-color: #F5F5F5; -fx-text-fill: #666666; -fx-background-radius: 8; -fx-padding: 10 24; -fx-cursor: hand;"/>
        <Button fx:id="btnSubmit" text="Xác nhận thêm" styleClass="action-btn-primary" prefWidth="140"/>
    </HBox>

</VBox>
