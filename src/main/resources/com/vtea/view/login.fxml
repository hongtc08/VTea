<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import org.kordamp.ikonli.javafx.*?>
<?import javafx.scene.image.*?>

<StackPane prefHeight="800" prefWidth="1280" styleClass="login-root" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vtea.controller.LoginController">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- Main Content -->
    <HBox prefHeight="800" prefWidth="1280" HBox.hgrow="ALWAYS">


    <!-- ===== LEFT PANEL: Branding ===== -->
    <StackPane styleClass="login-left-panel" HBox.hgrow="ALWAYS" style="-fx-clip: null;">

        <!-- Animated Scrolling Background -->
        <Pane fx:id="scrollingBackgroundPane" />

        <!-- Background Overlay to darken images for text readability -->
        <Region styleClass="background-overlay" style="-fx-background-color: linear-gradient(to right, rgba(28,25,23,0.85), rgba(28,25,23,0.4));" />

        <!-- Content -->
        <VBox alignment="CENTER_LEFT" spacing="0">
            <padding><Insets bottom="80" left="80" right="80" top="80" /></padding>

            <!-- Logo Icon -->
            <StackPane maxHeight="100" maxWidth="100" styleClass="logo-icon-box" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-padding: 0;">
                <VBox.margin><Insets bottom="32" /></VBox.margin>
                <ImageView fitWidth="120" fitHeight="120" preserveRatio="true" style="-fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
                    <image>
                        <Image url="@/images/logo.png" />
                    </image>
                    <clip>
                        <Rectangle width="120" height="120" arcWidth="30" arcHeight="30" />
                    </clip>
                </ImageView>
            </StackPane>

            <!-- Brand Name -->
            <Label styleClass="brand-name" text="VTea" />
            <Label styleClass="brand-sub" text="Cafe &amp; Trà Sữa" />

            <!-- Divider line -->
            <Rectangle height="4" styleClass="brand-divider" width="80">
                <VBox.margin><Insets bottom="24" top="16" /></VBox.margin>
            </Rectangle>

            <!-- Tagline -->
            <Label maxWidth="380" styleClass="brand-tagline" text="&quot;Nơi hương vị gặp gỡ cảm xúc&quot;" wrapText="true" />

            <!-- Feature list -->
            <VBox spacing="14">
                <VBox.margin><Insets top="48" /></VBox.margin>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Circle radius="5" styleClass="dot-accent" />
                    <Label styleClass="feature-text" text="Nguyên liệu tươi mới mỗi ngày" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Circle radius="5" styleClass="dot-accent" />
                    <Label styleClass="feature-text" text="Không gian ấm cúng, hiện đại" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Circle radius="5" styleClass="dot-accent" />
                    <Label styleClass="feature-text" text="Phục vụ tận tâm, chu đáo" />
                </HBox>
            </VBox>
        </VBox>

    </StackPane>

    <!-- ===== RIGHT PANEL: Login Form ===== -->
    <VBox alignment="CENTER" styleClass="login-right-panel" HBox.hgrow="ALWAYS">
        <padding><Insets bottom="60" left="80" right="80" top="60" /></padding>

        <!-- Form Card -->
        <VBox fx:id="formCard" maxWidth="420" spacing="0" styleClass="form-card">
            <padding><Insets bottom="48" left="48" right="48" top="48" /></padding>

            <!-- Header -->
            <Label styleClass="form-title" text="Đăng nhập" />
            <Label styleClass="form-subtitle" text="Chào mừng bạn quay trở lại!">
                <VBox.margin><Insets bottom="36" top="6" /></VBox.margin>
            </Label>

            <!-- Username Field -->
            <Label styleClass="field-label" text="Tên đăng nhập" />
            <TextField fx:id="txtUsername" promptText="Nhập tên đăng nhập" styleClass="input-field">
                <VBox.margin><Insets bottom="20" top="8" /></VBox.margin>
            </TextField>

            <!-- Password Field -->
            <Label styleClass="field-label" text="Mật khẩu" />
            <StackPane>
                <VBox.margin><Insets bottom="16" top="8" /></VBox.margin>
                <PasswordField fx:id="txtPassword" promptText="Nhập mật khẩu" styleClass="input-field" />
                <TextField fx:id="txtPasswordVisible" promptText="Nhập mật khẩu" styleClass="input-field" visible="false" managed="false" />
            </StackPane>

            <!-- Remember Me & Forgot Password -->
            <HBox alignment="CENTER_LEFT">
                <VBox.margin><Insets bottom="28" /></VBox.margin>
                <CheckBox fx:id="showPasswordCheckbox" styleClass="field-label" text="Hiển thị mật khẩu" />
                <Region HBox.hgrow="ALWAYS" />
                <Hyperlink fx:id="forgotPasswordLink" onAction="#handleForgotPassword" styleClass="forgot-password-link" text="Quên mật khẩu?" />
            </HBox>

            <!-- Login Button -->
            <Button fx:id="btnLogin" defaultButton="true" maxWidth="Infinity" onAction="#handleLogin" styleClass="btn-primary" text="Đăng nhập" />

        </VBox>
    </VBox>

    </HBox>

    <!-- Overlay Loading -->
    <StackPane fx:id="loadingOverlay" styleClass="loading-overlay" visible="false">
        <VBox alignment="CENTER" spacing="16" styleClass="spinner-box" maxWidth="350" maxHeight="180">
            <StackPane>
                <ProgressIndicator fx:id="loadingSpinner" prefWidth="50" prefHeight="50" />
                <FontIcon fx:id="successIcon" iconLiteral="fth-check-circle" iconSize="50" iconColor="#22c55e" visible="false" />
            </StackPane>
            <Label fx:id="loadingLabel" text="Đang xử lý..." styleClass="loading-text" wrapText="true" textAlignment="CENTER"/>
            <ProgressBar fx:id="successProgressBar" prefWidth="200" progress="0.0" visible="false" managed="false"/>
        </VBox>
    </StackPane>

</StackPane>
