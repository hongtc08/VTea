<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      styleClass="cart-item-container" spacing="10" alignment="TOP_LEFT">

    <!-- Left spacer (no image) -->
    <Region minWidth="12" />

    <!-- Main column: name, unit price, toppings, add topping button, qty+subtotal -->
    <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" spacing="6" alignment="TOP_LEFT">
        <!-- Row: name -->
        <Label fx:id="lblCartName" styleClass="cart-item-name" text="Tên món" wrapText="true" />

        <!-- Row: unit price -->
        <Label fx:id="lblCartPrice" styleClass="cart-item-price" text="0đ" />

        <!-- Row: toppings list (if any) -->
        <VBox fx:id="toppingsContainer" spacing="4" visible="false" managed="false" />

        <!-- Row: add topping button -->
        <Button fx:id="btnTopping" text="Thêm topping" styleClass="btn-secondary" minWidth="90" />

        <!-- Row bottom: quantity controls + subtotal + remove -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <HBox alignment="CENTER" spacing="6" styleClass="qty-box">
                <Button fx:id="btnMinus" text="-" styleClass="qty-btn"/>
                <Label fx:id="lblQty" text="1" styleClass="qty-label"/>
                <Button fx:id="btnPlus" text="+" styleClass="qty-btn"/>
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <Label fx:id="lblSubTotal" styleClass="cart-item-price" text="0đ" />

            <!-- Nút xóa (X) đã được nâng cấp bằng icon -->
            <Button fx:id="btnRemove" styleClass="btn-remove-item">
                <graphic>
                    <FontIcon iconLiteral="fth-trash-2" iconSize="16" iconColor="#dc2626"/>
                </graphic>
            </Button>
        </HBox>
    </VBox>

</HBox>