<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<?import java.net.URL?>
<VBox spacing="20" styleClass="dialog-box" prefWidth="420" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vtea.controller.InvoiceDetailDialogController"
>
    <padding><Insets top="20" right="24" bottom="20" left="24"/></padding>

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT">
        <Label text="Chi tiết hóa đơn" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnCloseTop" style="-fx-background-color: transparent; -fx-cursor: hand;">
            <graphic><FontIcon iconLiteral="fth-x" iconSize="24" iconColor="#999999"/></graphic>
        </Button>
    </HBox>
    <Separator/>

    <VBox spacing="10">
        <HBox><Label text="Mã hóa đơn" styleClass="info-row-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDetailId" text="HD003" styleClass="info-row-value"/></HBox>
        <HBox><Label text="Ngày giờ" styleClass="info-row-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDetailDateTime" text="2026-06-02 - 16:00" styleClass="info-row-value"/></HBox>
        <HBox><Label text="Nhân viên xử lý" styleClass="info-row-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDetailEmployee" text="Trần Thị Bình" styleClass="info-row-value"/></HBox>
        <HBox><Label text="Khách hàng" styleClass="info-row-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDetailCustomer" text="Trần Thị B" styleClass="info-row-value"/></HBox>
        <HBox><Label text="Số điện thoại" styleClass="info-row-label"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDetailPhone" text="0912345678" styleClass="info-row-value"/></HBox>
    </VBox>

    <VBox spacing="10">
        <Label text="Sản phẩm" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
        <VBox fx:id="productItemsBox" styleClass="summary-box" spacing="8">
            <HBox alignment="CENTER_LEFT">
                <VBox>
                    <Label text="Trà đào cam sả" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
                    <Label text="50.000đ x 1" style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="50.000đ" style="-fx-text-fill: #523628; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </VBox>

    <VBox spacing="10" styleClass="summary-box">
        <HBox><Label text="Tạm tính:" style="-fx-text-fill: #666666;"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblSubTotal" text="50.000đ" style="-fx-text-fill: #666666;"/></HBox>
        <HBox><Label text="VAT (10%):" style="-fx-text-fill: #666666;"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblVat" text="5.000đ" style="-fx-text-fill: #666666;"/></HBox>
        <HBox><Label text="Giảm điểm (50 điểm):" style="-fx-text-fill: #12B6A2;"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="lblDiscount" text="-50.000đ" style="-fx-text-fill: #12B6A2;"/></HBox>
        <Separator style="-fx-padding: 4 0;"/>
        <HBox alignment="CENTER_LEFT">
            <Label text="Tổng cộng:" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblTotal" text="55.000đ" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #78350F;"/>
        </HBox>
    </VBox>

    <Button fx:id="btnCloseBottom" text="Đóng" styleClass="btn-primary" maxWidth="Infinity" prefHeight="44"/>
</VBox>