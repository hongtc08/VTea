<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<VBox spacing="20" styleClass="dialog-box" prefWidth="450" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.vtea.controller.StockUpdateController">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <HBox alignment="CENTER_LEFT">
        <Label fx:id="lblTitle" text="Nhập / Xuất kho" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnClose" onAction="#handleCancel" style="-fx-background-color: transparent; -fx-cursor: hand;">
            <graphic><FontIcon iconLiteral="fth-x" iconSize="24" iconColor="#999999"/></graphic>
        </Button>
    </HBox>
    <Separator/>

    <VBox spacing="16">

        <HBox spacing="16">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Tồn kho hiện tại" styleClass="form-label"/>
                <TextField fx:id="txtCurrentStock" editable="false" focusTraversable="false" styleClass="form-input-field" style="-fx-background-color: #f8fafc; -fx-text-fill: #64748b;"/>
            </VBox>
            <VBox spacing="6" prefWidth="120">
                <Label text="Đơn vị" styleClass="form-label"/>
                <TextField fx:id="txtUnit" editable="false" focusTraversable="false" styleClass="form-input-field" style="-fx-background-color: #f8fafc; -fx-text-fill: #64748b;"/>
            </VBox>
        </HBox>

        <VBox spacing="6">
            <Label text="Loại giao dịch *" styleClass="form-label"/>
            <ComboBox fx:id="cboChangeType" maxWidth="Infinity" promptText="Chọn loại giao dịch..." styleClass="form-input-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Số lượng thay đổi *" styleClass="form-label"/>
            <TextField fx:id="txtQuantity" promptText="Nhập số lượng (vd: 10)" styleClass="form-input-field"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Ghi chú / Lý do" styleClass="form-label"/>
            <TextField fx:id="txtNote" promptText="Nhập lý do điều chỉnh..." styleClass="form-input-field"/>
        </VBox>
    </VBox>

    <HBox spacing="16" alignment="CENTER_RIGHT">
        <VBox.margin><Insets top="10"/></VBox.margin>
        <Button fx:id="btnCancel" text="Hủy" onAction="#handleCancel" styleClass="btn-dialog-cancel" prefWidth="120" prefHeight="40"/>
        <Button fx:id="btnSubmit" text="Xác nhận" onAction="#handleSave" styleClass="btn-primary" prefWidth="160" prefHeight="40"/>
    </HBox>
</VBox>