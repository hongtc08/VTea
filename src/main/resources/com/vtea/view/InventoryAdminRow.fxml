<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import java.net.URL?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vtea.controller.InventoryAdminRowController"
      styleClass="list-item-row" alignment="CENTER_LEFT" spacing="16">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <!-- Tên nguyên liệu -->
    <HBox alignment="CENTER_LEFT" spacing="12" prefWidth="200">
        <StackPane styleClass="inventory-icon-box">
            <FontIcon iconLiteral="fth-package" iconSize="20" iconColor="#523628"/>
        </StackPane>
        <Label fx:id="lblName" text="Trân châu" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
    </HBox>

    <!-- Đơn vị -->
    <Label fx:id="lblUnit" text="kg" style="-fx-text-fill: #666666;" prefWidth="80"/>

    <!-- Tồn kho -->
    <Label fx:id="lblQuantity" text="50" style="-fx-font-weight: bold;" prefWidth="100"/>

    <!-- Mức tối thiểu -->
    <Label fx:id="lblMinStock" text="10" style="-fx-text-fill: #666666;" prefWidth="120"/>

    <!-- Tình trạng -->
    <HBox prefWidth="120" alignment="CENTER_LEFT">
        <StackPane fx:id="badgeStatus" styleClass="badge-success">
            <HBox alignment="CENTER" spacing="4">
                <FontIcon fx:id="iconWarning" iconLiteral="fth-alert-triangle" iconSize="14" iconColor="#D93025" visible="false" managed="false"/>
                <Label fx:id="lblStatus" text="Đủ hàng"/>
            </HBox>
        </StackPane>
    </HBox>

    <!-- Cập nhật lần cuối -->
    <Label fx:id="lblLastUpdate" text="2026-05-10" style="-fx-text-fill: #666666;" prefWidth="140"/>

    <!-- Người kiểm kê -->
    <Label fx:id="lblStaffName" text="Nguyễn Văn A" style="-fx-text-fill: #666666;" prefWidth="150"/>

    <!-- Thao tác -->
    <HBox prefWidth="120" alignment="CENTER" spacing="0">
        <Button fx:id="btnUpdateStock" onAction="#handleUpdateStock" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 8;">
            <graphic>
                <FontIcon iconLiteral="fth-plus-square" iconSize="18" iconColor="#10b981"/>
            </graphic>
        </Button>

        <Button fx:id="btnEdit" onAction="#handleEdit" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 8;">
            <graphic>
                <FontIcon iconLiteral="fth-edit-2" iconSize="18" iconColor="#1890ff"/>
            </graphic>
        </Button>

        <Button fx:id="btnDelete" onAction="#handleDelete" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4 8;">
            <graphic>
                <FontIcon iconLiteral="fth-trash-2" iconSize="18" iconColor="#D93025"/>
            </graphic>
        </Button>
    </HBox>
</HBox>
