<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="invoice-group-card">

    <HBox fx:id="groupHeader" styleClass="invoice-group-header" alignment="CENTER_LEFT" spacing="16" style="-fx-cursor: hand;">
        <FontIcon fx:id="iconArrow" iconLiteral="fth-chevron-right" iconSize="20" iconColor="#523628"/>
        <FontIcon iconLiteral="fth-calendar" iconSize="20" iconColor="#523628"/>
        <VBox alignment="CENTER_LEFT">
            <Label fx:id="lblGroupName" text="Tên Tháng (Sẽ thay đổi bằng Java)" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Label fx:id="lblGroupSub" text="Phụ đề" style="-fx-text-fill: #888888; -fx-font-size: 12px;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT">
            <Label fx:id="lblInvoiceCount" text="0 hóa đơn" style="-fx-text-fill: #666666;"/>
        </VBox>
    </HBox>

    <VBox fx:id="groupContent" visible="false" managed="false">
        <Separator/>
        <HBox styleClass="list-header-row" alignment="CENTER_LEFT" spacing="16">
            <Label text="Mã HĐ" styleClass="list-header-label" prefWidth="80"/>
            <Label text="Thời gian" styleClass="list-header-label" prefWidth="80"/>
            <Label text="Nhân viên" styleClass="list-header-label" prefWidth="140"/>
            <Label text="Khách hàng" styleClass="list-header-label" prefWidth="180"/>
            <Label text="Thanh toán" styleClass="list-header-label" prefWidth="100"/>
            <Label text="" prefWidth="80"/>
        </HBox>

        <VBox fx:id="invoiceListContainer"/>
    </VBox>
</VBox>