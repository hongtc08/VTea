<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.vtea.controller.TransactionRowController"
      styleClass="list-item-row" alignment="CENTER_LEFT" spacing="16">

    <padding><Insets left="16" right="16"/></padding>

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>

    <Label fx:id="lblTime" text="11/06/2026 05:06" style="-fx-text-fill: #666666;" prefWidth="140"/>

    <HBox prefWidth="120" alignment="CENTER_LEFT">
        <StackPane fx:id="badgeType" styleClass="badge-success">
            <Label fx:id="lblType" text="Nhập kho" style="-fx-font-weight: bold;"/>
        </StackPane>
    </HBox>

    <HBox alignment="CENTER_LEFT" spacing="12" prefWidth="180">
        <StackPane styleClass="inventory-icon-box">
            <FontIcon iconLiteral="fth-package" iconSize="16" iconColor="#523628"/>
        </StackPane>
        <Label fx:id="lblIngredient" text="Sữa tươi" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>

    <Label fx:id="lblQuantity" text="+20" style="-fx-font-weight: bold; -fx-text-fill: #10b981;" prefWidth="120"/>

    <Label fx:id="lblAdmin" text="Nguyễn Văn A" style="-fx-text-fill: #666666;" prefWidth="160"/>

    <Label fx:id="lblNote" text="Nhập thêm 20 thùng sữa" style="-fx-text-fill: #666666; -fx-wrap-text: true;"
           prefWidth="300" minWidth="300" maxWidth="300"/>

</HBox>