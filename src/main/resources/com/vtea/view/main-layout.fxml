<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.*?>
<?import java.net.URL?>


<?import org.kordamp.ikonli.javafx.FontIcon?>
<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vtea.controller.MainLayoutController"
            prefWidth="1280" prefHeight="800"
            styleClass="main-root">

    <stylesheets>
        <URL value="@../css/styles.css" />
    </stylesheets>


    <!-- ===== TOP: Header ===== -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="0">
            <padding><Insets top="12" right="24" bottom="12" left="24"/></padding>

            <!-- Logo -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <StackPane styleClass="header-logo-box" minWidth="48" minHeight="36">
                    <FontIcon iconLiteral="fth-coffee" styleClass="logo-icon" iconSize="22" iconColor="aliceblue"/>
                </StackPane>
                <VBox spacing="0">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label text="VTea" styleClass="header-brand"/>
                        <Circle radius="3" styleClass="header-dot"/>
                        <Label text="Cafe &amp; Trà Sữa" styleClass="header-sub"/>
                    </HBox>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Circle radius="4" styleClass="online-dot"/>
                        <Label text="Hệ thống đang hoạt động" styleClass="header-status"/>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Spacer -->
            <Region HBox.hgrow="ALWAYS"/>

            <!-- User Info -->
            <HBox styleClass="user-info-box" alignment="CENTER_LEFT" spacing="10">
                <StackPane styleClass="user-avatar">
                    <Label fx:id="userInitialLabel" text="A" styleClass="user-avatar-text"/>
                </StackPane>
                <VBox spacing="0">
                    <Label fx:id="userNameLabel" text="Admin" styleClass="user-name"/>
                    <Label fx:id="userRoleLabel" text="Quản lý" styleClass="user-role"/>
                </VBox>
            </HBox>

            <!-- Logout Button -->
            <Button text="  Đăng xuất"
                    styleClass="btn-logout"
                    onAction="#handleLogout">
                <graphic>
                    <FontIcon iconLiteral="fth-log-out" styleClass="header-icon-logout" iconSize="18"/>
                </graphic>
                <HBox.margin><Insets left="16"/></HBox.margin>
            </Button>

        </HBox>
    </top>

    <!-- ===== LEFT: Sidebar ===== -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="4">
            <padding><Insets top="20" right="12" bottom="20" left="12"/></padding>

            <Label text="MENU CHÍNH" styleClass="sidebar-section-title">
                <VBox.margin><Insets bottom="8" left="8"/></VBox.margin>
            </Label>

            <Button fx:id="btnDashboard"
                    text="Dashboard"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleDashboard">
                <graphic>
                    <FontIcon iconLiteral="mdi2v-view-dashboard-outline" styleClass="sidebar-icon-dashboard" iconSize="18"/>
                </graphic>
            </Button>

            <Button fx:id="btnPOS"
                    styleClass="pos-prominent-btn"
                    maxWidth="Infinity"
                    onAction="#handlePOS">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <StackPane style="-fx-background-color: rgba(255,255,255,0.15); -fx-background-radius: 8; -fx-padding: 8;">
                            <FontIcon iconLiteral="fth-shopping-cart" iconSize="24" iconColor="white"/>
                        </StackPane>
                        <VBox alignment="CENTER_LEFT" spacing="2" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="4">
                                <Label text="POS" style="-fx-font-size: 16px; -fx-font-weight: 900; -fx-text-fill: white;" minWidth="-Infinity"/>
                                <Label text="BÁN HÀNG" styleClass="pos-badge" minWidth="-Infinity"/>
                            </HBox>
                        </VBox>
                        <FontIcon iconLiteral="fth-zap" iconSize="18" styleClass="pos-lightning-icon"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="btnMenu"
                    text="Thực đơn"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleMenu">
                <graphic>
                    <FontIcon iconLiteral="fth-book-open" iconSize="18"/>
                </graphic>
            </Button>

            <Button fx:id="btnInventory"
                    text="Kho"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleInventory">
                <graphic>
                    <FontIcon iconLiteral="fth-package" styleClass="sidebar-icon" iconSize="18"/>
                </graphic>
            </Button>

            <Button fx:id="btnEmployee"
                    text="Nhân viên"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleEmployee">
                <graphic>
                    <FontIcon iconLiteral="fth-users" styleClass="sidebar-icon" iconSize="18"/>
                </graphic>
            </Button>

            <Button fx:id="btnCustomer"
                    text="Khách hàng"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleCustomer">
                <graphic>
                    <FontIcon iconLiteral="fth-user" styleClass="sidebar-icon" iconSize="18"/>
                </graphic>
            </Button>

            <Button fx:id="btnInvoice"
                    text="Hóa đơn"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleInvoiceHistory">
                <graphic>
                    <FontIcon iconLiteral="fth-file-text" styleClass="sidebar-icon" iconSize="18"/>
                </graphic>
            </Button>

            <Button fx:id="btnReport"
                    text="Thống kê"
                    styleClass="nav-btn"
                    maxWidth="Infinity"
                    onAction="#handleReport">
                <graphic>
                    <FontIcon iconLiteral="fth-pie-chart" styleClass="sidebar-icon" iconSize="18"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <!-- ===== CENTER: Content Area ===== -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>
        </StackPane>
    </center>

</BorderPane>
